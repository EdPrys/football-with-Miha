# Dedicated Telegram application credentials; not the existing channel bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Select a model supported by your OpenAI API project and set a project spend limit.
OPENAI_API_KEY=
OPENAI_MODEL=
# Persistent private directory: config.json, state.json, telegram.session.
OUTREACH_DATA_DIR=./.outreach

# Optional count-only API access; same dedicated token/prefix as API configuration.
OUTREACH_METRICS_URL=
OUTREACH_METRICS_TOKEN=
# Optional rates for estimated cost reporting; set from the selected model pricing.
OUTREACH_INPUT_USD_PER_MILLION=
OUTREACH_OUTPUT_USD_PER_MILLION=
