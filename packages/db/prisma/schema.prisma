// Football App — MVP schema. See docs/PRODUCT_PLAN.md.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum EventStatus {
  UPCOMING
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum ParticipantStatus {
  JOINED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Access roles, ordered PLAYER < MANAGER < ADMIN. Everyone can play regardless
// of role; higher roles add staff abilities. See docs/PRODUCT_PLAN.md.
enum Role {
  PLAYER // joins events, plays, rates
  MANAGER // + creates events (also a player)
  ADMIN // + manages users and creates venues/fields (also a player)
}

// MVP positions only. Extensible later (LB, CB, CDM, ...).
enum Position {
  GK
  DEF
  MID
  FWD
}

enum SkillType {
  PACE
  DRIBBLING
  PASSING
  SHOOTING
  DEFENDING
  PHYSICAL
}

enum NotificationType {
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  EVENT_CANCELLED
  EVENT_APPROACHING
  RATING_AVAILABLE
  MVP_AWARDED
}

enum RoleRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- Users & profile ----------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(PLAYER)
  avatarUrl    String?
  // Home city ("базування"); organizers invite players from the game's city.
  cityId       String   @default("kyiv")
  city         City     @relation(fields: [cityId], references: [id])
  // Where the signup came from (utm_* or ad click ids), for measuring ads.
  signupSource   String?
  signupMedium   String?
  signupCampaign String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile          PlayerProfile?
  organizedEvents  Event[]           @relation("EventOrganizer")
  participations   EventParticipant[]
  invitationsSent     Invitation[]   @relation("InvitationInviter")
  invitationsReceived Invitation[]   @relation("InvitationInvited")
  ratingsGiven     Rating[]          @relation("RatingRater")
  ratingsReceived  Rating[]          @relation("RatingRatee")
  notifications    Notification[]
  roleRequests     RoleRequest[]
  mvpVotesGiven    MvpVote[]         @relation("MvpVoter")
  mvpVotesReceived MvpVote[]         @relation("MvpNominee")
  mvpAwards        EventMvp[]

  @@index([cityId])
}

// The "football profile". Aggregated skills are stored in PlayerSkill rows,
// recomputed from ratings by the domain aggregation service.
model PlayerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills PlayerSkill[]
}

// One row per (profile, skill). value + ratingsCount are derived, never user-set.
model PlayerSkill {
  id            String        @id @default(cuid())
  profileId     String
  profile       PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill         SkillType
  value         Float         @default(0)
  ratingsCount  Int           @default(0)
  updatedAt     DateTime      @updatedAt

  @@unique([profileId, skill])
}

// ---------- Cities ----------
// Ukrainian cities players and venues are based in: oblast centres outside the
// occupied territories plus the largest cities of each oblast. Rows are added
// by migrations; id is a readable slug ("kyiv", "kryvyi-rih").
model City {
  id     String @id
  name   String @unique
  region String

  users  User[]
  venues Venue[]
}

// ---------- Venues & fields ----------
enum FieldEnvironment {
  OPEN_AIR
  COVERED
  INDOOR
}

enum FieldSurface {
  NATURAL_GRASS
  ARTIFICIAL_TURF
  PARQUET
  RUBBER
  HARD_COURT
  OTHER
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  cityId    String
  city      City     @relation(fields: [cityId], references: [id])
  createdAt DateTime @default(now())
  address          String?
  latitude         Float?
  longitude        Float?
  contactPhone     String?
  websiteUrl       String?
  // Total physical fields, when known; fields.length is only the listed count.
  totalFields      Int?
  hasChangingRooms Boolean?
  hasShowers       Boolean?
  hasParking       Boolean?
  sourceUrl        String?
  // Date the published source was checked, not a guarantee of availability.
  verifiedAt       DateTime?

  fields Field[]

  @@index([cityId])
}

model Field {
  id       String  @id @default(cuid())
  venueId  String
  venue    Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name     String
  capacity Int?    // supported player count; null means not established
  isActive Boolean @default(true)
  environment  FieldEnvironment?
  surface      FieldSurface?
  hasLighting  Boolean?
  lengthMeters Float?
  widthMeters  Float?

  events Event[]
}

// ---------- Events ----------
model Event {
  id             String      @id @default(cuid())
  organizerId    String
  organizer      User        @relation("EventOrganizer", fields: [organizerId], references: [id])
  fieldId        String
  field          Field       @relation(fields: [fieldId], references: [id])
  startAt        DateTime
  endAt          DateTime
  numberOfTeams  Int
  playersPerTeam Int
  // capacity is derived: numberOfTeams * playersPerTeam (never stored)
  // "DEF-MID-FWD" key from formationOptionsFor(playersPerTeam); GK is always 1 and implicit.
  formation      String?
  status         EventStatus @default(UPCOMING)
  // Set when the organizer finishes the game; star ratings close 24h later.
  finishedAt     DateTime?
  // Set once MVP voting is closed and winners are written to EventMvp.
  mvpResolvedAt  DateTime?
  // The channel post announcing the game, removed when the game is deleted.
  telegramMessageId Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  teams        Team[]
  participants EventParticipant[]
  invitations  Invitation[]
  ratings      Rating[]
  mvpVotes     MvpVote[]
  mvps         EventMvp[]

  @@index([status, startAt])
  @@index([fieldId, startAt])
}

model Team {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String

  participants EventParticipant[]

  @@unique([eventId, name])
}

model EventParticipant {
  id                String            @id @default(cuid())
  eventId           String
  event             Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            ParticipantStatus @default(JOINED)
  preferredPosition Position
  teamId            String?
  team              Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  joinedAt          DateTime          @default(now())

  @@unique([eventId, userId]) // can't join the same event twice
  @@index([userId])
}

model Invitation {
  id            String           @id @default(cuid())
  eventId       String
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inviterId     String
  inviter       User             @relation("InvitationInviter", fields: [inviterId], references: [id])
  invitedUserId String
  invitedUser   User             @relation("InvitationInvited", fields: [invitedUserId], references: [id])
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now())

  @@unique([eventId, invitedUserId])
  @@index([invitedUserId, status])
}

// One submission per (event, rater, ratee); scores all six skills 1..5. Immutable in MVP.
model Rating {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User     @relation("RatingRater", fields: [raterId], references: [id])
  rateeId   String
  ratee     User     @relation("RatingRatee", fields: [rateeId], references: [id])
  // One 1–5 star score per (event, rater, ratee).
  stars     Int
  // Legacy per-skill scores from before 2026-10-23 (skills are self-assessed
  // now). Kept read-only for history; new ratings leave them null.
  pace      Int?
  dribbling Int?
  passing   Int?
  shooting  Int?
  defending Int?
  physical  Int?
  createdAt DateTime @default(now())

  @@unique([eventId, raterId, rateeId])
  @@index([rateeId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
}

// A player asking for a higher role. Organizer requests are auto-approved for
// now; the row keeps the audit trail and lets us switch to manual review later.
model RoleRequest {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  status    RoleRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())
  decidedAt DateTime?

  @@index([userId, status])
}

// One MVP vote per player per finished game (same 24h window as stars).
model MvpVote {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  voterId   String
  voter     User     @relation("MvpVoter", fields: [voterId], references: [id], onDelete: Cascade)
  nomineeId String
  nominee   User     @relation("MvpNominee", fields: [nomineeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, voterId])
  @@index([nomineeId])
}

// MVP winner(s) of a game — several on a tie. A player's MVP count is the
// number of rows here.
model EventMvp {
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes   Int

  @@id([eventId, userId])
  @@index([userId])
}
