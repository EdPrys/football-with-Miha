# Postgres (matches docker-compose.yml)
POSTGRES_USER=football
POSTGRES_PASSWORD=football
POSTGRES_DB=football
DATABASE_URL=postgresql://football:football@localhost:5432/football?schema=public

# API
NODE_ENV=development
# /api-panel: defaults on in development, off elsewhere; explicit true/false overrides.
# API_PANEL_ENABLED=false
# Allowed frontend origins (comma-separated); unset reflects origins for local development.
WEB_ORIGIN=http://localhost:3000,http://localhost:3001
API_PORT=4000
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_URL=http://localhost:3000

# Telegram channel announcements (event creation posts here). Leave unset
# until the channel launches — postToTelegram is a no-op without both.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Avatar storage (S3-compatible; a Railway Bucket in prod, referenced as
# ${{avatars.BUCKET}} etc.). Leave unset to keep avatars inline in the DB.
# PUBLIC_API_URL is this API's public URL — avatar links point at its /avatars route.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
PUBLIC_API_URL=

# Optional read-only aggregate outreach metrics. Unset = route absent.
# Use a dedicated 32+ character random token; never a JWT or DB credential.
OUTREACH_METRICS_TOKEN=
OUTREACH_CAMPAIGN_PREFIX=organizers_pilot

# Password recovery (API only). Configure a verified sender in Resend.
# Recovery is unavailable without all three: key, sender and APP_URL above.
RESEND_API_KEY=
EMAIL_FROM=
# Enable only behind Railway HTTP edge; trusts its overwritten X-Real-IP header.
TRUST_RAILWAY_PROXY=false
